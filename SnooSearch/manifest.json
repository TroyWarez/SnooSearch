{
  "name": "Snoo Search", 
  "version": "1.0.0.0",
  "description": "Allows you to search using your default search engine with \" reddit\" added to the end of your search term(s).",
  "action": {},
  "manifest_version": 3,
  "icons": {
   "16": "icons/icon16.png",
   "32": "icons/icon32.png",
   "48": "icons/icon48.png",
   "128": "icons/icon128.png"
 },
  "permissions": [
      "contextMenus",
      "search"
   ],
   "background": {
    "service_worker": "worker.js"
   }
}