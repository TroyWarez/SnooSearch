{
  "name": "Snoo Search", 
  "version": "1.0.0.0",
  "description": "Allows you to search using your default search engine with \" reddit\" added to the end of your search term(s).",
  "manifest_version": 3,
  "action": {},
  "icons": {
   "16": "icons/icon16.png",
   "32": "icons/icon32.png",
   "48": "icons/icon48.png",
   "128": "icons/icon128.png"
  },
  "permissions": [
      "contextMenus",
      "search"
  ],
  "background": {
    "scripts": ["worker.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "SnooSearch@troysdomain.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
